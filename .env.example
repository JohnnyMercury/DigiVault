# Production runtime configuration (the real .env stays only on the server)
DIGIVAULT_CONNECTION_STRING=Host=localhost;Database=digivault;Username=postgres;Password=replace-me;Pooling=true;Minimum Pool Size=5;Maximum Pool Size=50;
MINIO_ACCESS_KEY=replace-me
MINIO_SECRET_KEY=replace-me
MINIO_PUBLIC_URL=https://storage.example.invalid

# GitHub repository (for production deployment)
GITHUB_REPOSITORY=your-username/digivault

# Image tag for Docker
IMAGE_TAG=latest
